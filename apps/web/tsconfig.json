{
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",

    /* === Paths / Aliases === */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "shared": ["../../packages/shared/src/index.ts"],
      "ai-processor": ["../../packages/ai-processor/src/index.ts"]
    },

    /* === Calidad y DX === */
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": false,
    "isolatedModules": true
  },

  /* Qué archivos toma */
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
