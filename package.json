{
  "name": "docu-mind-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "predev": "npm run build:shared && npm run build:ai-processor",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run dev",
    "build": "npm run build:shared && npm run build:ai-processor && npm run build:api && npm run build:web",
    "build:web": "cd apps/web && npm run build",
    "build:api": "cd apps/api && npm run build",
    "build:shared": "cd packages/shared && npm run build",
    "build:ai-processor": "cd packages/ai-processor && npm run build",
    "lint": "npm run lint:web && npm run lint:api",
    "preview": "cd apps/web && npm run preview",
    "db:generate": "cd apps/api && npm run db:generate",
    "db:migrate": "prisma migrate dev --schema=./src/prisma/schema.prisma",
    "db:push": "prisma db push --schema=./src/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./src/prisma/schema.prisma",
    "install:all": "npm install && cd apps/web && npm install && cd ../api && npm install",
    "clean": "rimraf node_modules apps/web/node_modules apps/api/node_modules packages/shared/node_modules packages/ai-processor/node_modules",
    "clean:install": "npm run clean && npm run install:all"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express-rate-limit": "^5.1.3",
    "@types/pdf-parse": "^1.1.5",
    "concurrently": "^8.2.2",
    "prisma": "^7.2.0",
    "rimraf": "^5.0.10"
  },
  "dependencies": {
    "@google/genai": "^1.35.0",
    "@prisma/adapter-better-sqlite3": "^6.3.0",
    "@prisma/client": "^7.2.0",
    "better-sqlite3": "^12.5.0",
    "express-rate-limit": "^8.2.1",
    "pdf-parse": "^2.4.5",
    "typescript": "^5.2.2"
  }
}
